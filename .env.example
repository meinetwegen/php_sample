# Copy to .env before running docker compose.
# APP_KEY:    echo "base64:$(openssl rand -base64 32)"
# JWT_SECRET: openssl rand -hex 32
APP_KEY=
JWT_SECRET=
APP_DEBUG=false
BACKEND_PORT=8000
WEB_PORT=8080
# Seed demo categories/magazines on start (set to false in production)
SEED_DATABASE=true
# The administrator account is created on start if it does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
