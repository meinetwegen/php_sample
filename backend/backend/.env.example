APP_NAME="Magazine Shop"
APP_ENV=local
# php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite (create the empty file first)

CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="${APP_NAME}"

# php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

SHIPPING_FLAT_CENTS=500
FREE_SHIPPING_CENTS=5000
L5_SWAGGER_GENERATE_ALWAYS=true
